APP_NAME=market-impact-radar
ENVIRONMENT=development
DATABASE_URL=sqlite:///./market_impact_radar.db
CONFIG_YAML=config.yaml

# OpenAI-compatible LLM API. Examples:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# For Ollama-compatible deployments, use the server's OpenAI-compatible endpoint.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# Optional title translation fallback.
# Priority: LLM analysis title > LLM title translation > other online translation > original title.
# Providers: llm, mymemory, libretranslate, disabled
TRANSLATION_PROVIDER=llm
TRANSLATION_BASE_URL=
TRANSLATION_API_KEY=
TRANSLATION_TIMEOUT_SECONDS=8

# Optional sources
NEWSAPI_API_KEY=
ALPHA_VANTAGE_API_KEY=

# SEC requires a descriptive user-agent with contact information.
SEC_USER_AGENT=market-impact-radar contact@example.com

# Enterprise WeChat robot webhook
WECOM_WEBHOOK_URL=
